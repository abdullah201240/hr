{
  "name": "hr-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "echo 'Error: db:push is disabled. Use migrations instead.' && exit 1",
    "db:studio": "drizzle-kit studio",
    "db:pull": "drizzle-kit pull",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --verbose --forceExit",
    "test:e2e:health": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Health' --forceExit",
    "test:e2e:auth": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Auth Module' --forceExit",
    "test:e2e:departments": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Departments' --forceExit",
    "test:e2e:designations": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Designations' --forceExit",
    "test:e2e:employees": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Employees' --forceExit",
    "test:e2e:upload": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Upload' --forceExit",
    "test:e2e:announcements": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Announcements' --forceExit",
    "test:e2e:attendance-settings": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Attendance Settings' --forceExit",
    "test:e2e:leave-types": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Leave Types' --forceExit",
    "test:e2e:attendance": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Attendance Module' --forceExit",
    "test:e2e:leave-applications": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Leave Applications' --forceExit",
    "test:e2e:recruitment": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Recruitment' --forceExit",
    "test:e2e:salary": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Salary Module' --forceExit",
    "test:e2e:tasks": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Tasks' --forceExit",
    "test:e2e:roles": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Roles' --forceExit",
    "test:e2e:notifications": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Notifications' --forceExit",
    "test:e2e:claims": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Claims' --forceExit",
    "test:e2e:dashboard": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Dashboard' --forceExit",
    "test:e2e:disciplinary": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Disciplinary' --forceExit",
    "test:e2e:letters": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Letters' --forceExit",
    "test:e2e:org-chart": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Org Chart' --forceExit",
    "test:e2e:performance": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Performance' --forceExit",
    "test:e2e:provident-fund": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Provident Fund' --forceExit",
    "test:e2e:separation": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Separation' --forceExit",
    "test:e2e:chat": "jest --config ./test/jest-e2e.json --runInBand --verbose -t 'Chat' --forceExit",
    "test:seed": "npx tsx test/seed-test-data.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.26",
    "@nestjs/platform-ws": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/websockets": "^11.1.27",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
