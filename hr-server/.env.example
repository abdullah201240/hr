# ─────────────────────────────────────────────────────────────
# HR Management System - Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values
# Command: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Application
NODE_ENV=development  # development | production | test
PORT=3000
API_PREFIX=api

# CORS (comma-separated origins for production)
# Development: http://localhost:5173
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────
# Local: postgresql://user:password@localhost:5432/hr_db
# Production: Use SSL mode require and connection pooling
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_POOL_SIZE=10  # Connection pool size (default: 10)

# ─────────────────────────────────────────────────────────────
# Redis (Cache & Job Queue)
# ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=300  # Cache TTL in seconds (default: 5 minutes)

# ─────────────────────────────────────────────────────────────
# Cloudinary (File Storage)
# ─────────────────────────────────────────────────────────────
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_SECURE=true  # Always true for HTTPS URLs
CLOUDINARY_MAX_FILE_SIZE=10485760  # 10 MB in bytes
CLOUDINARY_DEFAULT_FOLDER=hr-system

# ─────────────────────────────────────────────────────────────
# BullMQ (Job Queue)
# ─────────────────────────────────────────────────────────────
BULLMQ_CONCURRENCY=5  # Max concurrent job processing

# ─────────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────────
# ⚠️  SECURITY CRITICAL: Generate strong random secrets!
#
# Generate secure secrets:
#   Node.js: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   OpenSSL: openssl rand -hex 64
#
# Development: If not set, falls back to dev secrets with warnings
# Production: MUST be set or app will fail to start
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=generate-a-secure-random-64-char-string
JWT_REFRESH_SECRET=generate-a-different-secure-random-64-char-string
JWT_ACCESS_EXPIRY=15m  # Access token expiry (default: 15 minutes)
JWT_REFRESH_EXPIRY=7d  # Refresh token expiry (default: 7 days)
